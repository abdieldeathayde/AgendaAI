# Aplicação
SECRET_KEY=change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.pythonanywhere.com

# Banco local/Docker
DB_NAME=agendaai
DB_USER=agendaai
DB_PASSWORD=agendaai_password
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-root-password

# Produção/Render: se DATABASE_URL existir, ela terá prioridade.
# DATABASE_URL=mysql://usuario:senha@host:3306/banco
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Segurança
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://*.pythonanywhere.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.pythonanywhere.com
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# E-mail
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@agendaai.local
