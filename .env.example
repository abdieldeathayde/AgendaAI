# Aplicação
SECRET_KEY=change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.hostingerapp.com,.hostinger.com,meu-dominio.com,123.45.67.89

# Banco local/Docker
DB_NAME=agendaai
DB_USER=agendaai
DB_PASSWORD=agendaai_password
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-root-password

# Render / produção: se DATABASE_URL existir, ela terá prioridade.
# DATABASE_URL=mysql://usuario:senha@host:3306/banco
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Segurança
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://*.onrender.com,https://*.vercel.app,https://*.hostingerapp.com,https://*.hostinger.com,https://meu-dominio.com,https://www.meu-dominio.com,https://123.45.67.89
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.onrender.com,https://*.vercel.app,https://*.hostingerapp.com,https://*.hostinger.com,https://meu-dominio.com,https://www.meu-dominio.com,https://123.45.67.89
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# E-mail
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@agendaai.local
